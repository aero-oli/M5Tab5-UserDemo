{
  "idf.buildPath": "${workspaceFolder}/build",
  "idf.sdkconfigFilePath": "${workspaceFolder}/sdkconfig",

  "idf.flashType": "UART",
  "idf.flashBaudRate": "921600",
  "idf.monitorEnableTimestamps": true,

  "idf.saveBeforeBuild": true,
  "idf.enableCCache": true,
  "idf.enableSizeTaskAfterBuildTask": true,
  "idf.notificationMode": "Notifications",
  "idf.telemetry": false,

  "C_Cpp.intelliSenseEngine": "disabled",

  "clangd.arguments": [
    "--background-index",
    "--completion-style=detailed",
    "--header-insertion=never",
    "--compile-commands-dir=${workspaceFolder}/build",
    "--query-driver=${env:HOME}/.espressif/tools/**/bin/*gcc,${env:HOME}/.espressif/tools/**/bin/*g++,${env:HOME}/esp/**/bin/*gcc,${env:HOME}/esp/**/bin/*g++"
  ],

  "files.associations": {
    "*.h": "cpp",
    "*.hpp": "cpp",
    "*.hh": "cpp",
    "*.c": "c",
    "*.cpp": "cpp",
    "CMakeLists.txt": "cmake",
    "Kconfig*": "kconfig",
    "sdkconfig*": "kconfig"
  },

  "files.exclude": {
    "**/.DS_Store": true,
    "**/build/**": true,
    "**/managed_components/**": true
  },

  "search.exclude": {
    "**/build/**": true,
    "**/managed_components/**": true,
    "../../dependencies/**": true
  },

  "files.watcherExclude": {
    "**/build/**": true,
    "**/managed_components/**": true,
    "../../dependencies/**": true
  }
}
